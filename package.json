{
  "name": "signet",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram Mini App and bot to sign and date PDF documents directly on mobile with zero third-party dependencies",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm --workspace=server run dev",
    "dev:web": "npm --workspace=web run dev",
    "dev": "npm --workspace=server run dev",
    "build:server": "npm --workspace=server run build",
    "build:web": "npm --workspace=web run build",
    "build": "npm run build:web && npm run build:server",
    "test": "npm --workspace=server run test",
    "start": "npm --workspace=server run start"
  },
  "keywords": [
    "telegram",
    "telegram-mini-app",
    "pdf",
    "pdf-signing",
    "fastify",
    "grammy",
    "react",
    "typescript"
  ],
  "author": "alexandrmotologa",
  "license": "MIT"
}
