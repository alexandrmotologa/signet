# Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Server networking
PORT=8080
HOST=0.0.0.0

# Base URL where frontend or Telegram Mini App is hosted
# In development, you can set this to your local Vite or tunnel URL (e.g. http://localhost:5173 or http://localhost:8080)
WEB_APP_URL=http://localhost:8080

# Ephemeral file storage directory for temporary uploaded/signed PDFs
STORAGE_DIR=./storage

# Node environment
NODE_ENV=development
